{
  "name": "media-transcoding-pipeline",
  "version": "1.0.0",
  "type": "module",
  "description": "Distributed media transcoding pipeline using RabbitMQ, MinIO and ffmpeg",
  "author": "Leon Yalin",
  "scripts": {
    "up": "docker compose up -d",
    "up:workers": "docker compose up -d --scale worker=${WORKERS:-4}",
    "down": "docker compose down",
    "build:worker": "docker compose build worker",
    "logs:worker": "docker compose logs -f worker",
    "infra:init": "tsx --env-file=.env scripts/infra-init.ts",
    "dev:api": "tsx watch --env-file=.env src/api/index.ts",
    "load": "tsx --env-file=.env scripts/load.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/lib-storage": "^3.1104.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-amqplib": "^0.68.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.76.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "amqplib": "^2.0.1",
    "fastify": "^5.11.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.1.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
