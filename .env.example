# Values here target processes running on the HOST (the API, scripts, tests).
# Worker containers get service-name equivalents from docker-compose.yml.

# RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672
AMQP_PREFETCH=1
RETRY_TTL_MS=10000
MAX_ATTEMPTS=3

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
BUCKET_UPLOADS=media-uploads
BUCKET_OUTPUTS=media-outputs

# Redis
REDIS_URL=redis://localhost:6379
JOB_TTL_SECONDS=86400

# Transcoding
MAX_UPLOAD_BYTES=524288000
HLS_SEGMENT_SECONDS=4

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=media-pipeline

# Networking & ports
API_PORT=3000
WORKER_METRICS_PORT=9101

# App env
NODE_ENV=development
